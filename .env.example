# Copy to .env. Only T3_TOKEN is required.

# T3 Code server. Create a token with: t3 auth session issue --ttl 30d --label treebot --token-only
T3_URL=http://127.0.0.1:3773
T3_TOKEN=

# Where Treebot listens. Keep 127.0.0.1 unless something in front of it handles sign-in.
HOST=127.0.0.1
PORT=3780

# Bots, the Vault and settings live here. Defaults to ~/.treebot
# TREEBOT_HOME=

# Sign-in when reachable from other devices: set a password, or use Cloudflare Access.
# BOT_PASSWORD=
# CF_ACCESS_TEAM_DOMAIN=
# CF_ACCESS_AUD=
# CF_ACCESS_EMAILS=you@example.com

# Connected apps through Executor (optional).
# EXECUTOR_BACKEND=self-hosted
# EXECUTOR_URL=http://127.0.0.1:3000
# EXECUTOR_ORG=
# EXECUTOR_TOKEN=
